# ── Database (Postgres no kairos-shared-pg) ────────────────────────────────
DATABASE_URL="postgresql://kairos_viagens:CHANGE_ME@kairos-shared-pg:5432/kairos_viagens_db?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────
# Gere um token forte: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_WITH_OPENSSL_RAND_BASE64_48"
ADMIN_BOOTSTRAP_EMAIL="admin@kairosviagens.com"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://viagens.fbautomacao.space"
NODE_ENV="production"
PORT="3000"
